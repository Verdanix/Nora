<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <name>Nora</name>
    <description>
        Nora is an open-source voice assistant offering customization, flexibility,
        and control with an easy setup and plugin interface for all users.
    </description>
    <modules>
        <module>core</module>
        <module>common</module>
        <module>audio</module>
    </modules>
    <version>1.0.0-BETA</version>
    <groupId>dev.masonroot</groupId>
    <artifactId>Nora</artifactId>
    <packaging>pom</packaging>
    <modelVersion>4.0.0</modelVersion>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>GNU GPLv3</name>
            <url>https://choosealicense.com/licenses/gpl-3.0/</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependencies -->
        <testng.version>7.10.2</testng.version>
        <lombok.version>1.18.36</lombok.version>
        <mockito.testng.version>0.5.2</mockito.testng.version>
        <sherpa.onnx.version>1.10.42</sherpa.onnx.version>

        <!-- Plugins -->
        <git-code-format-maven-plugin.version>5.3</git-code-format-maven-plugin.version>
        <maven.plugins>3.5.2</maven.plugins>
        <maven.jxr.plugin>3.6.0</maven.jxr.plugin>
        <maven.install.plugin.version>3.1.3</maven.install.plugin.version>
        <maven.antrun.plugin.version>3.1.0</maven.antrun.plugin.version>

        <!-- Other -->
        <sherpa.install.path>${project.build.directory}/lib/sherpa-onnx.jar</sherpa.install.path>
    </properties>

    <repositories>
        <repository>
            <id>jcenter</id>
            <name>bintray</name>
            <url>http://jcenter.bintray.com</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- TestNG -->
        <!-- This dependency adds testing capabilities to Nora. -->
        <!-- Github: https://github.com/testng-team/testng/ -->
        <!-- Documentation: https://testng.org/ -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-testng</artifactId>
            <version>${mockito.testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <!-- This dependency adds useful annotations to limit the amount of code written. -->
        <!-- Github: https://github.com/projectlombok/lombok/ -->
        <!-- Documentation: https://projectlombok.org/ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Shade PLugin -->
            <!-- This plugin is used to create a single jar file with all the dependencies -->
            <!-- Github: https://github.com/apache/maven-shade-plugin -->
            <!-- Documentation: https://maven.apache.org/plugins/maven-shade-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.plugins}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.masonroot.nora.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Git code format plugin -->
            <!-- This plugin will format your code on commit and validate it on Maven verify phase -->
            <!-- Documentation: https://github.com/cosium/git-code-format-maven-plugin -->
            <plugin>
                <groupId>com.cosium.code</groupId>
                <artifactId>git-code-format-maven-plugin</artifactId>
                <version>${git-code-format-maven-plugin.version}</version>
                <executions>
                    <!-- On commit, format the modified files -->
                    <execution>
                        <id>install-formatter-hook</id>
                        <goals>
                            <goal>install-hooks</goal>
                        </goals>
                    </execution>
                    <!-- On Maven verify phase, fail if any file
                    (including unmodified) is badly formatted -->
                    <execution>
                        <id>validate-code-format</id>
                        <goals>
                            <goal>validate-code-format</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <!-- Enable https://github.com/google/google-java-format -->
                    <dependency>
                        <groupId>com.cosium.code</groupId>
                        <artifactId>google-java-format</artifactId>
                        <version>${git-code-format-maven-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Maven Surefire Plugin -->
            <!-- This plugin is used to run the TestNG tests -->
            <!-- Documentation: https://maven.apache.org/surefire/maven-surefire-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.plugins}</version>
                <configuration>
                    <parallel>methods</parallel>
                    <threadCount>4</threadCount>
                    <suiteXmlFiles>
                        <suiteXmlFile>${project.basedir}/src/main/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

            <!-- Maven Antrun Plugin -->
            <!-- This plugin is used to download sherpa-onnx.jar from the Github repository -->
            <!-- Github: https://github.com/apache/maven-antrun-plugin -->
            <!-- Documentation: https://maven.apache.org/plugins/maven-antrun-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin.version}</version>
                <executions>
                    <execution>
                        <id>download-sherpa</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <target>
                        <mkdir dir="${project.build.directory}/lib"/>
                        <get src="https://github.com/k2-fsa/sherpa-onnx/releases/download/v${sherpa.onnx.version}/sherpa-onnx-v${sherpa.onnx.version}-java17.jar"
                             dest="${sherpa.install.path}"/>
                    </target>
                </configuration>
            </plugin>

            <!-- Maven Install Plugin -->
            <!-- This plugin is used to install the project into the local repository -->
            <!-- Github: https://github.com/apache/maven-install-plugin -->
            <!-- Documentation: https://maven.apache.org/plugins/maven-install-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${maven.install.plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-sherpa</id>
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <file>${sherpa.install.path}</file>
                    <groupId>com.k2fsa.sherpa.onnx</groupId>
                    <artifactId>sherpa-onnx</artifactId>
                    <version>${sherpa.onnx.version}</version>
                    <packaging>jar</packaging>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <reporting>
        <plugins>
            <!-- Maven Surefire Report Plugin -->
            <!-- This plugin is used to generate the TestNG test reports -->
            <!-- Documentation: https://maven.apache.org/surefire/maven-surefire-report-plugin/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven.plugins}</version>
                <configuration>
                    <aggregate>true</aggregate>
                    <linkXRef>true</linkXRef>
                    <outputDirectory>${project.basedir}/target/reports/</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>${maven.jxr.plugin}</version>
            </plugin>
        </plugins>
    </reporting>
</project>
